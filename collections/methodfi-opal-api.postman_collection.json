        {
          "id": "f87cadd6-8174-4cf4-ab23-47e2ff8e6b48",
          "name": "Create an Opal token",
          "request": {
            "name": "Create an Opal token",
            "description": {
              "content": "Creates a new Opal token and, depending on the creation pattern, a new session. Supports three patterns: (A) provide `entity_id` + `mode` + mode config, (B) provide inline `entity` + `mode` + mode config, or (C) provide `session_id` to create an additional token for an existing session.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "opal",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API version to use for this request. This spec targets `2025-12-01`.\nThe SDK sets this header automatically.\n",
                "key": "Method-Version",
                "value": "2025-12-01"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity_id\": \"<string>\",\n  \"entity\": {\n    \"type\": \"<string>\",\n    \"individual\": \"<object>\"\n  },\n  \"session_id\": \"<string>\",\n  \"mode\": \"<string>\",\n  \"appearance\": \"<string>\",\n  \"identity_verification\": {\n    \"skip_pii\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"card_connect\": {\n    \"selection_type\": \"<string>\",\n    \"account_filters\": {\n      \"exclude\": {\n        \"mch_ids\": [\n          \"<string>\",\n          \"<string>\"\n        ],\n        \"unverified_account_numbers\": \"<boolean>\"\n      }\n    },\n    \"skip_pii\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"connect\": {\n    \"selection_type\": \"<string>\",\n    \"account_filters\": {\n      \"include\": {\n        \"account_types\": [\n          \"<string>\",\n          \"<string>\"\n        ],\n        \"products\": [\n          \"<string>\"\n        ]\n      },\n      \"exclude\": {\n        \"account_types\": [\n          \"<string>\",\n          \"<string>\"\n        ],\n        \"mch_ids\": [\n          \"<string>\",\n          \"<string>\"\n        ],\n        \"unverified_account_numbers\": \"<boolean>\"\n      }\n    },\n    \"skip_pii\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"account_verification\": {\n    \"account_id\": \"<string>\",\n    \"intent\": \"<string>\"\n  },\n  \"transactions\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
